# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# --- secrets / local env ---
.env
.env.*.local
*.local
SECURITY_AUDIT.md

# --- Go ---
bin/
tmp/
# Scratch worker build dir (also in .air.toml exclude_dir).
tmp-worker/
# Stray binaries from `go build ./cmd/...` at the repo root.
/spacefleet
/spacefleet-infra
*.log
*.test
*.out
coverage.out
coverage.html

# --- Claude Code ---
# Keep .claude/settings.json (shared), agents/, commands/, hooks/, skills/ — ignore per-user only.
.claude/settings.local.json
.claude/**/*.local.json
.claude/scheduled_tasks.lock
CLAUDE.custom.md

# --- Node / frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.cache/
.parcel-cache/

# --- TypeScript / Vite ---
*.tsbuildinfo

# --- Test artifacts ---
# Playwright (e2e) output.
ui/test-results/
ui/playwright-report/
ui/blob-report/
# playwright-cli skill scratch output (snapshots, console logs, screenshots).
.playwright-cli/
# Stray screenshots saved to the repo root by playwright-cli runs.
/*.png

# --- UI build artifacts (regenerated by `make ui-build`) ---
# Keep .gitkeep so go:embed has something to match on fresh clones.
ui/dist/*
!ui/dist/.gitkeep

# --- Helm ---
# Packaged chart artifacts (produced by `helm package`).
deploy/charts/*/*.tgz
