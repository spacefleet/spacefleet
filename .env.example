# Secret used to envelope-encrypt stored credentials (e.g. registered cluster
# tokens/kubeconfigs). Base64-encoded 32-byte key. The value below is a sample
# for local dev only — generate your own with `make secret-key` and NEVER reuse
# this one outside development. Leave empty to disable secret storage (features
# that store no secrets, like in-cluster cluster registration, still work).
SPACEFLEET_SECRET_KEY=nTs1wv/wXlYpVfBAmy1HibIFHUfD0utwKytCJAFwN/A=

ADDR=:8080
ENV=development

# Postgres (matches docker-compose defaults)
POSTGRES_USER=spacefleet
POSTGRES_PASSWORD=spacefleet
POSTGRES_DB=spacefleet
DATABASE_URL=postgres://spacefleet:spacefleet@localhost:5432/spacefleet?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# OIDC (Dex) auth. Non-secret values — also surfaced to the browser via
# /config.js. These point at the Dex container in docker-compose.yml, which
# is bootstrapped with a static dev login (admin@example.com / "password").
# Clear both to fall back to the dev passthrough verifier that accepts every
# request as "dev-user" (NEVER use the passthrough in production).
OIDC_ISSUER=http://localhost:5556/dex
OIDC_CLIENT_ID=spacefleet

# Max background jobs the worker process runs in parallel.
WORKER_CONCURRENCY=4
