# Secret used to envelope-encrypt stored credentials (e.g. registered cluster
# tokens/kubeconfigs). Base64-encoded 32-byte key. The value below is a sample
# for local dev only — generate your own with `make secret-key` and NEVER reuse
# this one outside development. Leave empty to disable secret storage (features
# that store no secrets, like in-cluster cluster registration, still work).
SPACEFLEET_SECRET_KEY=nTs1wv/wXlYpVfBAmy1HibIFHUfD0utwKytCJAFwN/A=

ADDR=:8080
ENV=development

# Canonical public base URL of this deployment (no trailing slash). The single
# source of truth for external links the backend builds (e.g. invitation
# links), so they never depend on ingress config. Required — the server refuses
# to boot without it. In dev this is the Vite origin (the app's front door); it
# joins OIDC_ISSUER below as a value pinned to the :2424 dev origin.
EXTERNAL_URL=http://localhost:2424

# Postgres (matches docker-compose defaults)
POSTGRES_USER=spacefleet
POSTGRES_PASSWORD=spacefleet
POSTGRES_DB=spacefleet
DATABASE_URL=postgres://spacefleet:spacefleet@localhost:5432/spacefleet?sslmode=disable

# OIDC (Dex) auth. Non-secret values. Spacefleet always authenticates against
# its bundled Dex — there is no passthrough/unauthenticated mode, and the server
# refuses to boot without OIDC_ISSUER. The dev Dex (docker-compose.yml) is
# bootstrapped with a static login (admin@example.com / "password").
#
# The app is the single front door: the browser reaches Dex same-origin under
# the app's /dex path (Vite :2424 -> Go :8080 -> Dex :5556), so the issuer is
# the app origin, not Dex's. OIDC_ISSUER is also surfaced to the browser via
# /config.js. The backend verifies tokens by fetching keys straight from Dex
# (OIDC_JWKS_URL) and reverse-proxies the browser-facing routes to it
# (DEX_UPSTREAM_URL) — mirroring the in-cluster Helm setup.
OIDC_ISSUER=http://localhost:2424/dex
OIDC_CLIENT_ID=spacefleet
OIDC_JWKS_URL=http://localhost:5556/dex/keys
DEX_UPSTREAM_URL=http://localhost:5556

# Sign-in options shown on the login screen, as a JSON array of
# {id,name,type}. Each becomes a button that deep-links to that Dex connector
# (?connector_id=<id>). It mirrors the connectors Dex is configured with — Dex
# has no runtime API to list them. The dev Dex (dev/dex/config.yaml) is
# password-only; its built-in password DB is the connector id "local". Leave
# empty for a single generic "Sign in" button. Non-secret. Example with an
# upstream connector:
# LOGIN_METHODS=[{"id":"github","name":"GitHub","type":"github"},{"id":"local","name":"Email and password","type":"password"}]
LOGIN_METHODS=[{"id":"local","name":"Email and password","type":"password"}]

# Max background jobs the worker process runs in parallel.
WORKER_CONCURRENCY=4

# Whether users may create new organizations. On by default. Set to false to
# lock the app down so only invited users (added to an existing org) can use
# it — a signed-in user with no organization is then shown a "request an
# invite" message instead of a create-organization screen. Enforced
# server-side; this value is non-secret and surfaced to the browser.
ALLOW_ORG_CREATION=true

# Whether registered cluster endpoints (the token/kubeconfig methods, whose
# endpoint is user-supplied) may point at loopback or private (RFC1918/ULA)
# addresses. In production this defaults to FALSE (the code/chart default) so an
# org member can't use the server as an SSRF proxy to localhost services or the
# internal pod network. It's set true HERE because local dev typically registers
# a kind cluster at https://127.0.0.1:<port> (loopback) to test against — leave
# it false if you have no such cluster. The cloud-metadata endpoint
# (169.254.169.254) is rejected regardless of this flag.
ALLOW_PRIVATE_CLUSTER_ENDPOINTS=true

# SMTP (outbound email — used for invitation emails). Optional: leave SMTP_HOST
# or SMTP_FROM empty to disable email, in which case invitations still produce a
# copy-able link an admin can send manually. SMTP_PASSWORD is a secret. Whether
# email is enabled (host+from set) is surfaced to the browser via /config.js.
# SMTP_PORT defaults to 587 and SMTP_STARTTLS to true (the usual submission
# setup). For local testing, point these at a catcher like MailHog.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Github app for private repositories
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
