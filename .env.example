# Secret used to envelope-encrypt stored credentials (e.g. registered cluster
# tokens/kubeconfigs). Base64-encoded 32-byte key. The value below is a sample
# for local dev only — generate your own with `make secret-key` and NEVER reuse
# this one outside development. Leave empty to disable secret storage (features
# that store no secrets, like in-cluster cluster registration, still work).
SPACEFLEET_SECRET_KEY=nTs1wv/wXlYpVfBAmy1HibIFHUfD0utwKytCJAFwN/A=

ADDR=:8080
ENV=development

# Postgres (matches docker-compose defaults)
POSTGRES_USER=spacefleet
POSTGRES_PASSWORD=spacefleet
POSTGRES_DB=spacefleet
DATABASE_URL=postgres://spacefleet:spacefleet@localhost:5432/spacefleet?sslmode=disable

# OIDC (Dex) auth. Non-secret values. Spacefleet always authenticates against
# its bundled Dex — there is no passthrough/unauthenticated mode, and the server
# refuses to boot without OIDC_ISSUER. The dev Dex (docker-compose.yml) is
# bootstrapped with a static login (admin@example.com / "password").
#
# The app is the single front door: the browser reaches Dex same-origin under
# the app's /dex path (Vite :2424 -> Go :8080 -> Dex :5556), so the issuer is
# the app origin, not Dex's. OIDC_ISSUER is also surfaced to the browser via
# /config.js. The backend verifies tokens by fetching keys straight from Dex
# (OIDC_JWKS_URL) and reverse-proxies the browser-facing routes to it
# (DEX_UPSTREAM_URL) — mirroring the in-cluster Helm setup.
OIDC_ISSUER=http://localhost:2424/dex
OIDC_CLIENT_ID=spacefleet
OIDC_JWKS_URL=http://localhost:5556/dex/keys
DEX_UPSTREAM_URL=http://localhost:5556

# Max background jobs the worker process runs in parallel.
WORKER_CONCURRENCY=4
